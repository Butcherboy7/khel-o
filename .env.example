# KHEL-O — Environment Variables Template

# App Settings
ENVIRONMENT=development # Required: development, staging, production
SECRET_KEY=super-secret-key-change-in-production-at-least-32-chars # Required
FRONTEND_URL=http://localhost:3000 # Required

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/khel_o_db # Required

# Token Expiry Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15 # Optional, default 15
REFRESH_TOKEN_EXPIRE_DAYS=30 # Optional, default 30

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com # Required for Google Auth
GOOGLE_CLIENT_SECRET=your-google-client-secret # Required for Google Auth

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id # Required for Payments
RAZORPAY_KEY_SECRET=your_razorpay_key_secret # Required for Payments

# Resend Email API Credentials
RESEND_API_KEY=re_123456789_your_resend_api_key # Required for Emails
