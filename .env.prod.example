# KHEL-O — Production environment file.
# Copy this to `.env.prod` ON THE SERVER ONLY (never commit the real file).
# docker-compose.prod.yml reads every service's config from this one file.

# ---- Domain / TLS ----
# The domain Caddy requests a certificate for. Must already point (A record)
# at this server's Elastic IP before `docker compose up` — Caddy auto-issues
# and renews via Let's Encrypt on first request.
DOMAIN=khel-o.online

# ---- App ----
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_WITH_A_REAL_GENERATED_SECRET
FRONTEND_URL=https://khel-o.online

# ---- Database (Postgres — required in production, SQLite is rejected at boot) ----
POSTGRES_USER=khelo
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_REAL_GENERATED_PASSWORD
POSTGRES_DB=khel_o_db
DATABASE_URL=postgresql+asyncpg://khelo:REPLACE_ME_WITH_A_REAL_GENERATED_PASSWORD@postgres:5432/khel_o_db

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Google OAuth 2.0 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Razorpay (keep in TEST mode until you're ready to accept real money) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ROUTE_ENABLED=false
# Must be false in production. Only unlocks the backend's mock-payment
# signature bypass, and only when explicitly set true (never implied by
# ENVIRONMENT) — keep this and NEXT_PUBLIC_ENABLE_SANDBOX_MOCK_PAYMENTS in sync.
ENABLE_SANDBOX_MOCK_PAYMENTS=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Resend (forgot-password emails) ----
RESEND_API_KEY=

# ---- Sentry ----
# Backend and frontend use DIFFERENT Sentry projects/DSNs — see earlier setup.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://khel-o.online
NEXT_PUBLIC_APP_URL=https://khel-o.online
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

CONVENIENCE_FEE_AMOUNT=10
UNVERIFIED_CAFE_BOOKING_CAP_VALUE=5000
UNVERIFIED_CAFE_BOOKING_CAP_COUNT=15
